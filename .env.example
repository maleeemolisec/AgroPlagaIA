# Copiá este archivo como .env (o definí las variables en el panel del hosting)
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Inicio de sesión con Google (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional en producción si la app está detrás de un proxy HTTPS:
# GOOGLE_REDIRECT_URI=https://tu-dominio/login/google/callback
# Verificación de correo por Gmail SMTP (requiere una contraseña de aplicación)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=tu-correo@gmail.com
# SMTP_PASSWORD=contraseña-de-aplicacion-de-16-caracteres
# SMTP_FROM=tu-correo@gmail.com
# SQLite (por defecto):
# DATABASE_URL=sqlite:///agroplaga.db
# PostgreSQL (por ejemplo, Neon):
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
# MySQL:
# DATABASE_URL=mysql://usuario:clave@usuario.mysql.pythonanywhere-services.com/usuario$agroplaga
